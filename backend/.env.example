# Modelo do .env do backend. Copie para `.env` e preencha com os valores reais.
# Em produção (Render), estas variáveis ficam no painel do serviço.

# ── Banco de dados e autenticação ───────────────────────────────────────────
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco
JWT_SECRET=uma_chave_longa_e_aleatoria

# ── Cloudinary (imagens) ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# ── E-mail (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_sua_api_key
EMAIL_FROM=nao-responda@seu-dominio.com.br
# Segredo do webhook de e-mail de entrada (chamados abertos por e-mail)
RESEND_WEBHOOK_SECRET=whsec_seu_segredo

# ── WhatsApp (Zenvia) ───────────────────────────────────────────────────────
ZENVIA_API_TOKEN=seu_token_da_zenvia
# Número remetente conectado na Zenvia, só dígitos (55 + DDD + número)
ZENVIA_FROM=5551999999999
# ID do template aprovado pela Meta para avisar a conclusão de chamado
ZENVIA_TEMPLATE_TICKET_DONE=id_do_template
# Segredo exigido na URL do webhook: /api/whatsapp/webhook/<segredo>
WHATSAPP_WEBHOOK_SECRET=um_segredo_longo_e_aleatorio
# "true" registra no log o payload recebido da Zenvia
WHATSAPP_DEBUG=false

# ── Opcionais (o código tem valor padrão ou funciona sem) ───────────────────
# Porta do servidor (padrão: 3001)
# PORT=3001

# URL do frontend usada nos links dos e-mails (padrão: https://painel.vcorporate.com.br)
# FRONTEND_URL=http://localhost:3000

# Azure Blob Storage para documentos. Sem ele, documentos vão para o
# Cloudinary, com limite de 10 MB.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=documentos

# Caminho de um Chrome/Chromium instalado, para gerar certificados em PDF
# localmente (em produção usa o @sparticuz/chromium)
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Logos das empresas usadas nos e-mails do Mural de Avisos (URLs)
# LOGO_V_CORP=
# LOGO_V_TAX=
# LOGO_V_BANKING=
# LOGO_V_BUSINESS=
# LOGO_V_TECH=
